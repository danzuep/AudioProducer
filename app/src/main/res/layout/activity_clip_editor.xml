<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/clip_toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/clip_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/clip_toolbar"
        app:layout_constraintBottom_toTopOf="@id/clip_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/clip_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Record the enabled words in card order. Suggested boundaries are not speech recognition: drag the handles and review each clip. Moving a boundary changes both neighboring clips. Reordering cards does not move their audio. Repeated Greek forms share a saved clip."
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </com.google.android.material.card.MaterialCardView>

            <Spinner
                android:id="@+id/clip_guide_mode"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:contentDescription="Recording guide language" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/clip_tokens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:chipSpacingHorizontal="4dp" />
            </HorizontalScrollView>
            <EditText
                android:id="@+id/clip_custom_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your recording guide"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clip_record"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Record verse"
                    app:icon="@android:drawable/ic_btn_speak_now" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/clip_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="false"
                    android:text="0 / 0 reviewed" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#171E29"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp">
                        <TextView
                            android:id="@+id/clip_timing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No recording"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clip_zoom_out"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Zoom out"
                            android:text="−"
                            android:textColor="#FFFFFF" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clip_zoom_in"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Zoom in"
                            android:text="+"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <io.github.danzuep.bibleaudioproducer.ui.VerseSliceWaveform
                        android:id="@+id/clip_waveform"
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        android:contentDescription="Spoken waveform. Tap a slice or drag a boundary." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/clip_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clip_keep"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep existing" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clip_preview_existing"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play existing" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clip_finish"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finish verse" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fine tuning (seconds)"
                android:textAppearance="?attr/textAppearanceLabelLarge" />
            <EditText
                android:id="@+id/clip_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Start"
                android:inputType="numberDecimal"
                android:singleLine="true" />
            <SeekBar android:id="@+id/clip_start_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/clip_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="End"
                android:inputType="numberDecimal"
                android:singleLine="true" />
            <SeekBar android:id="@+id/clip_end_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/clip_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clip_nudge_back"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-10ms"
            android:contentDescription="Move end boundary back 10 milliseconds" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clip_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="Next" />
            <TextView
                android:id="@+id/clip_next_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saves clip on Next"
                android:textAppearance="?attr/textAppearanceLabelSmall" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clip_nudge_forward"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+10ms"
            android:contentDescription="Move end boundary forward 10 milliseconds" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
