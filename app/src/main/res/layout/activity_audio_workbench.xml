<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_workbench_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/audio_workbench_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="8dp"
        app:navigationIconTint="@color/workbench_primary_dark"
        app:titleTextColor="@color/workbench_primary_dark" />

    <LinearLayout
        android:id="@+id/audio_projects_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/audio_projects_heading"
            android:textAppearance="?attr/textAppearanceHeadline6" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/audio_project_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_project_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_project_new" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/audio_project_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/audio_workbench_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Spinner
                    android:id="@+id/audio_workbench_books"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/audio_workbench_choose_book" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audio_workbench_chapter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/audio_chapter_filter" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audio_choose_verse"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:text="@string/audio_choose_verse" />
            </LinearLayout>
            <EditText
                android:id="@+id/audio_workbench_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/audio_workbench_search_hint"
                android:inputType="text"
                android:singleLine="true" />
            <TextView
                android:id="@+id/audio_workbench_coverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:textAppearance="?attr/textAppearanceSubtitle1" />
        </LinearLayout>
        <TextView
            android:id="@+id/audio_workbench_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/audio_workbench_empty"
            android:textAppearance="?attr/textAppearanceBody1" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/audio_workbench_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/audio_settings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <Button
            android:id="@+id/audio_settings_back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:contentDescription="@string/audio_back"
            android:text="←" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_step_settings"
            android:textAppearance="?attr/textAppearanceHeadline6" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/audio_language_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_language_description"
            android:textAppearance="?attr/textAppearanceBody1" />
        <EditText
            android:id="@+id/audio_workbench_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/audio_workbench_language_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/audio_export_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_export_description"
            android:textAppearance="?attr/textAppearanceBody1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_workbench_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_workbench_export" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_import_archive"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_import_archive" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/audio_settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_settings_description"
            android:textAppearance="?attr/textAppearanceBody1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_tts_voice_settings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_tts_voice_choose" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_workbench_import"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_workbench_import" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_clear_data"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_clear_data" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_attribution"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_attribution" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/audio_navigation_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>
