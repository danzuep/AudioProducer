<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_workbench_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/audio_workbench_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_workbench_import"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_workbench_import" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_workbench_export"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/audio_workbench_export" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/audio_workbench_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">
        <EditText
            android:id="@+id/audio_workbench_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/audio_workbench_language_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:singleLine="true" />
        <Spinner
            android:id="@+id/audio_workbench_books"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/audio_workbench_choose_book" />
        <EditText
            android:id="@+id/audio_workbench_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/audio_workbench_search_hint"
            android:inputType="text"
            android:singleLine="true" />
        <TextView
            android:id="@+id/audio_workbench_coverage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceSubtitle1" />
    </LinearLayout>

    <TextView
        android:id="@+id/audio_workbench_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/audio_workbench_empty"
        android:textAppearance="?attr/textAppearanceBody1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/audio_workbench_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp" />
</LinearLayout>
